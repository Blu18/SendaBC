# Copia este archivo a `.env.local` y llena los valores. Nunca subas `.env` ni `.env.local` al
# repositorio (constitución 3.6). Expo los lee al iniciar Metro; si cambias uno, reinicia Metro.

# URL base del backend, sin barra final.
#   Emulador con `adb reverse tcp:3000 tcp:3000`: http://localhost:3000
#   Teléfono en la misma red: http://192.168.1.50:3000 (la IP de tu computadora)
#   Backend publicado: https://<ip-con-guiones>.sslip.io
EXPO_PUBLIC_BACKEND_IP=http://localhost:3000

# Token público de Mapbox (empieza con pk.). Sin él, los mapas no cargan; la grabación sigue igual.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.tu-token-publico-de-mapbox

# Opcionales, solo para pruebas. El APK de entrega no los define.
# EXPO_PUBLIC_BATTERY_TEST=1          # agrega la vista "Sin mapa" para medir la batería (spec 011)
# EXPO_PUBLIC_SAFETY_DEBUG_MINUTES=1  # acorta la alerta por inactividad a N minutos; solo en desarrollo (spec 008)
