// ============================================================
// SendaBC — Contrato de datos (Prisma Next / Prisma 8 + PostGIS)
// ============================================================
// Este proyecto usa Prisma Next (contract-first), no Prisma ORM
// clásico: no hay bloques `generator`/`datasource`. La conexión y
// las extensiones se configuran en prisma.config.ts. Este archivo
// es el "contrato" — se compila con `npx prisma contract emit`,
// lo que regenera schema.json y schema.d.ts (no editar a mano).
//
// Las relaciones solo se declaran en el lado que tiene la FK; el
// framework deriva la relación inversa automáticamente.
//
// Columnas geoespaciales: la extensión PostGIS de Prisma Next (en
// esta versión) solo expone un tipo `geometry` genérico parametrizado
// por SRID (postgis.Geometry(srid: 4326)), sin distinguir Point de
// LineString a nivel de contrato. Se usa 4326 (WGS84, lat/lng en
// grados) en todas las columnas geoespaciales.
// ============================================================

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum ActivityType {
  @@type("pg/text@1")
  HIKING        = "HIKING"
  TRAIL_RUNNING = "TRAIL_RUNNING"
  CYCLING       = "CYCLING"
}

enum ActivityStatus {
  @@type("pg/text@1")
  RECORDING    = "RECORDING"    // grabándose en el dispositivo
  PENDING_SYNC = "PENDING_SYNC" // terminada localmente, esperando subir
  SYNCED       = "SYNCED"       // ya está en el backend
}

enum RouteStatus {
  @@type("pg/text@1")
  DRAFT     = "DRAFT"
  PUBLISHED = "PUBLISHED"
  ARCHIVED  = "ARCHIVED"
}

enum RouteDifficulty {
  @@type("pg/text@1")
  EASY     = "EASY"
  MODERATE = "MODERATE"
  HARD     = "HARD"
  EXTREME  = "EXTREME"
}

enum AlertReason {
  @@type("pg/text@1")
  INACTIVITY_TIMEOUT = "INACTIVITY_TIMEOUT"
  MANUAL_SOS         = "MANUAL_SOS"
}

enum AlertStatus {
  @@type("pg/text@1")
  PENDING      = "PENDING"
  NOTIFIED     = "NOTIFIED"
  ACKNOWLEDGED = "ACKNOWLEDGED"
  RESOLVED     = "RESOLVED"
}

enum DevicePlatform {
  @@type("pg/text@1")
  IOS     = "IOS"
  ANDROID = "ANDROID"
}

// ------------------------------------------------------------
// USUARIOS
// ------------------------------------------------------------

model User {
  id Uuid @id @default(uuid())

  // Si usan Supabase Auth, este campo referencia auth.users.id y esta
  // tabla queda como "perfil público" (patrón típico de Supabase). Si
  // usan Passport + JWT propio, ignoren este campo.
  authUserId Uuid?   @unique
  email      String  @unique
  displayName String
  avatarUrl  String?

  // Contacto de emergencia — módulo de seguridad
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@map("users")
}

// ------------------------------------------------------------
// ACTIVIDADES (sesiones grabadas por el usuario)
// ------------------------------------------------------------

model Activity {
  id     Uuid @id @default(uuid())
  userId Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UUID generado en el dispositivo al crear la actividad. Se usa como
  // llave de idempotencia: si el batch de sync se reintenta (por
  // conexión inestable en zonas sin señal), el backend puede detectar
  // que ya la recibió y no duplicarla.
  clientGeneratedId Uuid? @unique

  type   ActivityType
  status ActivityStatus @default(RECORDING)

  startedAt DateTime
  endedAt   DateTime?

  distanceMeters      Float?
  durationSeconds     Int?
  elevationGainMeters Float?
  elevationLossMeters Float?

  // Track simplificado para dibujar el mapa y como base geoespacial si
  // la actividad se publica como ruta.
  path postgis.Geometry(srid: 4326)?

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([userId])
  @@map("activities")
}

// ------------------------------------------------------------
// PUNTOS GPS CRUDOS (replay, depuración y cálculo de métricas)
// ------------------------------------------------------------

model ActivityPoint {
  // BigInt autoincremental: una actividad puede tener miles de puntos,
  // y los inserts en batch son más baratos que con UUID.
  id         BigInt   @id @default(autoincrement())
  activityId Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  sequence Int // orden del punto dentro de la actividad
  location       postgis.Geometry(srid: 4326)
  altitudeMeters Float? // del barómetro, más preciso que el GPS
  accuracyMeters Float?
  recordedAt     DateTime

  @@index([activityId, sequence])
  @@map("activity_points")
}

// ------------------------------------------------------------
// RUTAS PÚBLICAS (catálogo comunitario)
// ------------------------------------------------------------

model Route {
  id Uuid @id @default(uuid())

  createdByUserId Uuid
  createdBy       User @relation(fields: [createdByUserId], references: [id])

  // Actividad de origen (opcional: una ruta podría crearse a mano)
  sourceActivityId Uuid?     @unique
  sourceActivity   Activity? @relation(fields: [sourceActivityId], references: [id])

  name        String
  description String?
  type        ActivityType
  difficulty  RouteDifficulty?
  status      RouteStatus      @default(DRAFT)

  distanceMeters      Float?
  elevationGainMeters Float?

  // Para dibujar en el mapa
  path postgis.Geometry(srid: 4326)?
  // Para "rutas cercanas" vía .dwithin() en el query builder
  startPoint postgis.Geometry(srid: 4326)?

  region String? // p. ej. "Ensenada", "Sierra de Juárez"

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([status])
  @@map("routes")
}

// ------------------------------------------------------------
// RUTAS GUARDADAS / FAVORITAS (N:N usuario–ruta)
// ------------------------------------------------------------

model RouteFavorite {
  userId    Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId   Uuid
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, routeId])
  @@map("route_favorites")
}

// ------------------------------------------------------------
// MÓDULO DE SEGURIDAD — alertas de inactividad / SOS
// ------------------------------------------------------------

model EmergencyAlert {
  id         Uuid     @id @default(uuid())
  activityId Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  reason AlertReason
  status AlertStatus @default(PENDING)

  // Copia del contacto al momento de la alerta: si el usuario lo
  // cambia después, la alerta conserva a quién se notificó.
  contactName  String?
  contactPhone String?

  triggeredAt DateTime  @default(now())
  notifiedAt  DateTime?
  resolvedAt  DateTime?

  @@index([activityId])
  @@map("emergency_alerts")
}

// ------------------------------------------------------------
// DISPOSITIVOS (tokens de push notification — Expo)
// ------------------------------------------------------------

model Device {
  id     Uuid @id @default(uuid())
  userId Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expoPushToken String         @unique
  platform      DevicePlatform

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("devices")
}
