generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pgcrypto(schema: "extensions"), pg_stat_statements(schema: "extensions"), uuid_ossp(map: "uuid-ossp", schema: "extensions"), supabase_vault(schema: "vault")]
}

enum ActivityType {
  HIKING
  TRAIL_RUNNING
  CYCLING
}

enum ActivityStatus {
  RECORDING // grabándose en el dispositivo
  PENDING_SYNC // terminada localmente, esperando subir
  SYNCED // ya está en el backend
}

// Fuente de la elevación de una actividad (spec 004, RN-3; se sube en la spec 005)
enum ElevationSource {
  BAROMETER
  GPS
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum RouteDifficulty {
  EASY
  MODERATE
  HARD
  EXTREME
}

enum AlertReason {
  INACTIVITY_TIMEOUT
  MANUAL_SOS
  RETURN_TIME_EXCEEDED // hora de regreso + 30 min sin terminar (spec 008, CA-18)
}

// Estado de una alerta (spec 008). Una sola ACTIVE por sesión (índice parcial, CA-27).
enum AlertStatus {
  ACTIVE
  CANCELLED // el usuario la canceló (CA-25)
  RESOLVED // la sesión terminó tras una alerta por hora de regreso (CA-22)
}

// Estado de un contacto de emergencia (spec 008, CA-1, CA-5, CA-7)
enum ContactStatus {
  PENDING // "Pendiente de aceptar"
  ACTIVE // "Activo"
  UNREACHABLE // "No recibe mensajes": bloqueó al bot o borró la conversación
}

// Tipo de mensaje enviado por Telegram (spec 008)
enum MessageKind {
  WELCOME
  TEST
  ALERT
  LOCATION
  CANCELLED
  FINISHED
}

enum MessageStatus {
  SENT
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
}

model User {
  avatarId          String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  displayName       String
  email             String             @unique
  id                String             @id @default(uuid()) @db.Uuid
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  passwordHash      String
  activities        Activity[]
  devices           Device[]
  emergencyContacts EmergencyContact[]
  favorites         RouteFavorite[]
  routes            Route[]            @relation("RouteCreator")
  safetySessions    SafetySession[]
  alertMessages     AlertMessage[]

  @@map("users")
}

model Activity {
  clientGeneratedId   String?                                    @unique @db.Uuid
  createdAt           DateTime                                   @default(now()) @db.Timestamptz(6)
  distanceMeters      Float?
  durationSeconds     Int?
  elevationGainMeters Float?
  elevationLossMeters Float?
  elevationSource     ElevationSource?
  endedAt             DateTime?                                  @db.Timestamptz(6)
  id                  String                                     @id @default(uuid()) @db.Uuid
  isPublished         Boolean                                    @default(false)
  path                Unsupported("geometry(LineString, 4326)")?
  startedAt           DateTime                                   @db.Timestamptz(6)
  status              ActivityStatus                             @default(RECORDING)
  type                ActivityType
  updatedAt           DateTime                                   @updatedAt @db.Timestamptz(6)
  userId              String                                     @db.Uuid
  user                User                                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  points              ActivityPoint[]
  route               Route?

  @@index([userId], map: "activities_userId_idx_a489d58a")
  @@index([path], map: "activities_path_gist_idx", type: Gist)
  @@map("activities")
}

model ActivityPoint {
  accuracyMeters Float?
  activityId     String                               @db.Uuid
  altitudeMeters Float?
  id             BigInt                               @id @default(autoincrement())
  location       Unsupported("geometry(Point, 4326)")
  recordedAt     DateTime                             @db.Timestamptz(6)
  sequence       Int
  activity       Activity                             @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([activityId, sequence], map: "activity_points_activityId_sequence_key")
  @@index([activityId], map: "activity_points_activityId_idx_bf2a659e")
  @@map("activity_points")
}

model Route {
  createdAt           DateTime                                   @default(now()) @db.Timestamptz(6)
  createdByUserId     String?                                    @db.Uuid
  description         String?
  difficulty          RouteDifficulty?
  distanceMeters      Float?
  elevationGainMeters Float?
  elevationProfile    Json?
  id                  String                                     @id @default(uuid()) @db.Uuid
  name                String
  path                Unsupported("geometry(LineString, 4326)")?
  region              String?
  sourceActivityId    String?                                    @unique @db.Uuid
  startPoint          Unsupported("geography(Point, 4326)")?
  status              RouteStatus                                @default(DRAFT)
  type                ActivityType
  updatedAt           DateTime                                   @updatedAt @db.Timestamptz(6)
  favorites           RouteFavorite[]
  createdBy           User?                                      @relation("RouteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceActivity      Activity?                                  @relation(fields: [sourceActivityId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdByUserId], map: "routes_createdByUserId_idx_93e8a540")
  @@index([status], map: "routes_status_idx_e98638ab")
  @@index([startPoint], map: "routes_startPoint_gist_idx", type: Gist)
  @@map("routes")
}

model RouteFavorite {
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  routeId   String   @db.Uuid
  userId    String   @db.Uuid
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, routeId])
  @@index([routeId], map: "route_favorites_routeId_idx_91ae2fd6")
  @@index([userId], map: "route_favorites_userId_idx_a489d58a")
  @@map("route_favorites")
}

// Contacto de emergencia, vinculado a Telegram al aceptar la invitación (spec 008, RN-2, RN-3)
model EmergencyContact {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  name           String
  status         ContactStatus  @default(PENDING)
  inviteToken    String?        @unique // null cuando está activo (RN-13)
  telegramChatId BigInt?
  telegramName   String?
  acceptedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages       AlertMessage[]

  @@unique([userId, telegramChatId])
  @@index([userId])
  @@map("emergency_contacts")
}

// Sesión de seguridad de una actividad en curso, con el clientGeneratedId de la actividad (spec 008, plan D1)
model SafetySession {
  id                String                                 @id @default(uuid()) @db.Uuid
  clientGeneratedId String                                 @unique @db.Uuid
  userId            String                                 @db.Uuid
  type              ActivityType
  startedAt         DateTime                               @db.Timestamptz(6)
  returnBy          DateTime?                              @db.Timestamptz(6)
  endedAt           DateTime?                              @db.Timestamptz(6)
  lastLocation      Unsupported("geography(Point, 4326)")?
  lastLocationAt    DateTime?                              @db.Timestamptz(6)
  createdAt         DateTime                               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                               @updatedAt @db.Timestamptz(6)
  user              User                                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alerts            EmergencyAlert[]

  @@index([userId])
  @@index([endedAt, returnBy])
  @@map("safety_sessions")
}

// Alerta de una sesión de seguridad (spec 008). Índice único parcial a mano en la migración:
// una sola alerta ACTIVE por sesión (CA-27, RN-8).
model EmergencyAlert {
  id                    String                                 @id @default(uuid()) @db.Uuid
  sessionId             String                                 @db.Uuid
  clientGeneratedId     String?                                @unique @db.Uuid // null en las del servidor (RETURN_TIME_EXCEEDED)
  reason                AlertReason
  status                AlertStatus                            @default(ACTIVE)
  triggeredAt           DateTime                               @db.Timestamptz(6)
  location              Unsupported("geography(Point, 4326)")?
  locationAt            DateTime?                              @db.Timestamptz(6)
  lastForwardedAt       DateTime?                              @db.Timestamptz(6)
  lastForwardedLocation Unsupported("geography(Point, 4326)")?
  resolvedAt            DateTime?                              @db.Timestamptz(6)
  createdAt             DateTime                               @default(now()) @db.Timestamptz(6)
  session               SafetySession                          @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages              AlertMessage[]

  @@index([sessionId])
  @@map("emergency_alerts")
}

// Cada envío por Telegram a un contacto (spec 008, CA-17). contactName es una copia al enviar.
model AlertMessage {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  alertId           String?           @db.Uuid // null en la prueba y la bienvenida
  contactId         String?           @db.Uuid
  contactName       String
  kind              MessageKind
  status            MessageStatus
  telegramMessageId BigInt?
  error             String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alert             EmergencyAlert?   @relation(fields: [alertId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact           EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@index([alertId])
  @@index([contactId, createdAt])
  @@map("alert_messages")
}

model Device {
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  expoPushToken String         @unique
  id            String         @id @default(uuid()) @db.Uuid
  platform      DevicePlatform
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "devices_userId_idx_a489d58a")
  @@map("devices")
}
