# Modelo de /etc/sendabc/api.env, el entorno del backend en la máquina virtual (spec 012, plan D8).
# Todos los valores de este archivo son falsos. El archivo real no va al repositorio (constitución 3.6):
#   sudo install -d -m 750 -o root -g sendabc /etc/sendabc
#   sudo install -m 640 -o root -g sendabc api.env.ejemplo /etc/sendabc/api.env   # y llena los valores
#
# Lo leen systemd (EnvironmentFile) y actualizar.sh (con `.`). Pon cada valor entre comillas simples,
# así los dos lo leen tal cual aunque tenga $, & o ?.

NODE_ENV='production'
# Puerto local de Node. Debe coincidir con el reverse_proxy del Caddyfile; no se abre hacia fuera.
PORT='3000'

# PostgreSQL de Supabase: el pooler para la app y la conexión directa para las migraciones.
DATABASE_URL='postgresql://<usuario>:<contraseña>@<host-del-pooler>:6543/postgres?pgbouncer=true'
DIRECT_URL='postgresql://<usuario>:<contraseña>@<host-directo>:5432/postgres'

# Secreto para firmar los JWT: una cadena larga y aleatoria (p. ej. `openssl rand -base64 48`).
JWT_SECRET='cambia-esto-por-un-secreto-largo-y-aleatorio'
# Vigencia del token, en formato de `ms` (p. ej. 7d, 12h).
JWT_EXPIRE_IN='7d'

# Bot de Telegram de producción (spec 008, plan D12). Distinto del de desarrollo.
TELEGRAM_MODE='webhook'
TELEGRAM_BOT_TOKEN='<token-de-BotFather>'
TELEGRAM_BOT_USERNAME='<usuario_del_bot>'
# Lo manda Telegram en X-Telegram-Bot-Api-Secret-Token; el mismo valor va en setWebhook (T16).
TELEGRAM_WEBHOOK_SECRET='<secreto-aleatorio>'
