{
  "info": {
    "name": "SendaBC API",
    "description": "Colección para validar la API de SendaBC (constitución 6.3). Ejecutar en orden: '1. Registro' (solo la primera vez), '2. Login' guarda el token y luego las peticiones de actividades, de rutas y de publicar rutas. Configura las variables baseUrl, email y password de la colección antes de empezar. Las variables lat y lng (Ensenada por defecto) son el centro de la búsqueda de rutas cercanas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "postman@senda.bc" },
    { "key": "password", "value": "contrasena-postman" },
    { "key": "token", "value": "" },
    { "key": "clientGeneratedId", "value": "" },
    { "key": "activityId", "value": "" },
    { "key": "lat", "value": "31.8667" },
    { "key": "lng", "value": "-116.5964" },
    { "key": "publishActivityBody", "value": "" },
    { "key": "publishActivityId", "value": "" },
    { "key": "routeId", "value": "" },
    { "key": "exampleRouteId", "value": "45bd31cd-1604-532c-abbd-8251a1ceed21" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 la primera vez; 409 si la cuenta ya existe (spec 001).",
                  "pm.test('201 o 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  pm.test('no devuelve passwordHash', () => pm.expect(pm.response.json()).to.not.have.property('passwordHash'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"displayName\": \"Prueba Postman\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/user"
          }
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve id y token', () => {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('token');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Actividades (spec 005)",
      "item": [
        {
          "name": "Subir lote",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cada ejecución sube una actividad nueva con un UUID v4 distinto.",
                  "pm.collectionVariables.set('clientGeneratedId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const [result] = pm.response.json().results;",
                  "pm.test('CREATED (CA-5)', () => pm.expect(result.status).to.eql('CREATED'));",
                  "pm.collectionVariables.set('activityId', result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activities\": [\n    {\n      \"clientGeneratedId\": \"{{clientGeneratedId}}\",\n      \"type\": \"HIKING\",\n      \"startedAt\": \"2026-10-09T10:00:00.000Z\",\n      \"endedAt\": \"2026-10-09T10:00:06.000Z\",\n      \"distanceMeters\": 24.6,\n      \"durationSeconds\": 6,\n      \"elevationGainMeters\": 0,\n      \"elevationLossMeters\": 0,\n      \"elevationSource\": \"GPS\",\n      \"points\": [\n        { \"sequence\": 1, \"latitude\": 31.8667, \"longitude\": -116.5964, \"altitude\": 20.5, \"accuracy\": 4.2, \"recordedAt\": \"2026-10-09T10:00:00.000Z\" },\n        { \"sequence\": 2, \"latitude\": 31.8668, \"longitude\": -116.5965, \"altitude\": 21.1, \"accuracy\": 3.9, \"recordedAt\": \"2026-10-09T10:00:03.000Z\" },\n        { \"sequence\": 3, \"latitude\": 31.8669, \"longitude\": -116.5966, \"altitude\": null, \"accuracy\": null, \"recordedAt\": \"2026-10-09T10:00:06.000Z\" }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/activities/sync"
          }
        },
        {
          "name": "Reenviar la misma actividad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const [result] = pm.response.json().results;",
                  "pm.test('ALREADY_EXISTS con el mismo id (CA-10)', () => {",
                  "  pm.expect(result.status).to.eql('ALREADY_EXISTS');",
                  "  pm.expect(result.id).to.eql(pm.collectionVariables.get('activityId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activities\": [\n    {\n      \"clientGeneratedId\": \"{{clientGeneratedId}}\",\n      \"type\": \"HIKING\",\n      \"startedAt\": \"2026-10-09T10:00:00.000Z\",\n      \"endedAt\": \"2026-10-09T10:00:06.000Z\",\n      \"distanceMeters\": 24.6,\n      \"durationSeconds\": 6,\n      \"elevationGainMeters\": 0,\n      \"elevationLossMeters\": 0,\n      \"elevationSource\": \"GPS\",\n      \"points\": []\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/activities/sync"
          }
        },
        {
          "name": "Lote con una actividad inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 aunque se rechace (CA-11)', () => pm.response.to.have.status(200));",
                  "const [result] = pm.response.json().results;",
                  "pm.test('REJECTED con motivos en español', () => {",
                  "  pm.expect(result.status).to.eql('REJECTED');",
                  "  pm.expect(result.errors).to.include('El fin de la actividad no puede ser anterior al inicio');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activities\": [\n    {\n      \"clientGeneratedId\": \"{{$guid}}\",\n      \"type\": \"HIKING\",\n      \"startedAt\": \"2026-10-09T10:00:00.000Z\",\n      \"endedAt\": \"2026-10-09T09:00:00.000Z\",\n      \"distanceMeters\": 0,\n      \"durationSeconds\": 0,\n      \"elevationGainMeters\": 0,\n      \"elevationLossMeters\": 0,\n      \"elevationSource\": \"GPS\",\n      \"points\": []\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/activities/sync"
          }
        },
        {
          "name": "Mis actividades",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('incluye la actividad subida (CA-20)', () => {",
                  "  pm.expect(lista.map((a) => a.id)).to.include(pm.collectionVariables.get('activityId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/activities"
          }
        },
        {
          "name": "Detalle de la actividad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const detalle = pm.response.json();",
                  "pm.test('trae sus 3 puntos en orden (CA-21)', () => {",
                  "  pm.expect(detalle.pointCount).to.eql(3);",
                  "  pm.expect(detalle.points.map((p) => p.sequence)).to.eql([1, 2, 3]);",
                  "  pm.expect(detalle.elevationSource).to.eql('GPS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/activities/{{activityId}}"
          }
        },
        {
          "name": "Detalle con id inválido (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Actividad no encontrada', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().message).to.eql('Actividad no encontrada');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/activities/no-es-un-uuid"
          }
        },
        {
          "name": "Sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 (CA-18)', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/activities"
          }
        }
      ]
    },
    {
      "name": "Rutas (spec 006)",
      "item": [
        {
          "name": "Rutas cercanas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const rutas = pm.response.json();",
                  "pm.test('como máximo 50, la más cercana primero (CA-5)', () => {",
                  "  pm.expect(rutas.length).to.be.at.most(50);",
                  "  const d = rutas.map((r) => r.distanceFromCenterMeters);",
                  "  pm.expect(d).to.eql([...d].sort((a, b) => a - b));",
                  "});",
                  "pm.test('dentro de 25 km y con recorrido [lng, lat] (CA-2, CA-4)', () => {",
                  "  rutas.forEach((r) => {",
                  "    pm.expect(r.distanceFromCenterMeters).to.be.at.most(25000);",
                  "    pm.expect(r).to.have.keys('id', 'name', 'type', 'difficulty', 'distanceMeters', 'elevationGainMeters', 'start', 'distanceFromCenterMeters', 'path', 'author', 'isMine');",
                  "    r.path.forEach(([lng, lat]) => {",
                  "      pm.expect(lng).to.be.within(-180, 180);",
                  "      pm.expect(lat).to.be.within(-90, 90);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/routes/nearby?lat={{lat}}&lng={{lng}}&radiusKm=25"
          }
        },
        {
          "name": "Radio fuera de rango (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 (RN-5)', () => pm.response.to.have.status(400));",
                  "pm.test('mensaje en español', () => {",
                  "  pm.expect(pm.response.json().errors.radiusKm).to.include('El radio debe estar entre 1 y 100 km');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/routes/nearby?lat={{lat}}&lng={{lng}}&radiusKm=101"
          }
        },
        {
          "name": "Rutas cercanas sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 (CA-17)', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/routes/nearby?lat={{lat}}&lng={{lng}}"
          }
        }
      ]
    },
    {
      "name": "Publicar rutas (spec 007)",
      "description": "Ejecutar en orden, después de \"2. Login\". Sube una actividad nueva de 3 km, la publica, la edita, la guarda en favoritas, la archiva, la vuelve a publicar y al final la borra. exampleRouteId es una ruta de ejemplo de SendaBC (npm run seed:rutas).",
      "item": [
        {
          "name": "Subir actividad de 3 km",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Una actividad nueva de 3 km en cada ejecución: 28 puntos hacia el norte (~111 m entre",
                  "// cada uno), en el océano Pacífico para no mezclarse con las rutas de ejemplo.",
                  "const inicio = Date.UTC(2026, 9, 20, 15);",
                  "const points = Array.from({ length: 28 }, (_, i) => ({",
                  "  sequence: i + 1,",
                  "  latitude: 24 + i * 0.001,",
                  "  longitude: -127,",
                  "  altitude: 500 + i * 10,",
                  "  accuracy: 4.8,",
                  "  recordedAt: new Date(inicio + i * 30000).toISOString(),",
                  "}));",
                  "pm.collectionVariables.set('publishActivityBody', JSON.stringify({",
                  "  activities: [{",
                  "    clientGeneratedId: pm.variables.replaceIn('{{$guid}}'),",
                  "    type: 'HIKING',",
                  "    startedAt: points[0].recordedAt,",
                  "    endedAt: points[points.length - 1].recordedAt,",
                  "    distanceMeters: 3000,",
                  "    durationSeconds: 810,",
                  "    elevationGainMeters: 350,",
                  "    elevationLossMeters: 0,",
                  "    elevationSource: 'GPS',",
                  "    points,",
                  "  }],",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const [result] = pm.response.json().results;",
                  "pm.test('CREATED', () => pm.expect(result.status).to.eql('CREATED'));",
                  "pm.collectionVariables.set('publishActivityId', result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/activities/sync",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{publishActivityBody}}"
            }
          }
        },
        {
          "name": "Publicar como ruta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 (CA-6)', () => pm.response.to.have.status(201));",
                  "const ruta = pm.response.json();",
                  "pm.collectionVariables.set('routeId', ruta.id);",
                  "pm.test('RouteDetail completo', () => pm.expect(ruta).to.have.keys('id', 'name', 'description', 'region', 'type', 'difficulty', 'distanceMeters', 'elevationGainMeters', 'start', 'path', 'elevationProfile', 'author', 'isMine', 'isFavorite', 'status', 'sourceActivityId', 'publishedAt'));",
                  "pm.test('datos de la actividad y dificultad calculada (RN-1, RN-6)', () => {",
                  "  pm.expect(ruta.type).to.eql('HIKING');",
                  "  pm.expect(ruta.distanceMeters).to.eql(3000);",
                  "  pm.expect(ruta.difficulty).to.eql('MODERATE');",
                  "  pm.expect(ruta.isMine).to.eql(true);",
                  "  pm.expect(ruta.status).to.eql('PUBLISHED');",
                  "});",
                  "pm.test('perfil de elevación (CA-11)', () => {",
                  "  pm.expect(ruta.elevationProfile.length).to.be.within(2, 200);",
                  "  pm.expect(ruta.elevationProfile[0]).to.eql([0, 500]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/routes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": \"{{publishActivityId}}\",\n  \"name\": \"Ruta de Postman\",\n  \"description\": \"Publicada desde la colección (spec 007).\",\n  \"region\": \"Océano Pacífico\"\n}"
            }
          }
        },
        {
          "name": "Publicar otra vez (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 (RN-2, CA-8)', () => pm.response.to.have.status(409));",
                  "pm.test('mensaje en español', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Esta actividad ya tiene una ruta publicada');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/routes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": \"{{publishActivityId}}\",\n  \"name\": \"Otra vez\"\n}"
            }
          }
        },
        {
          "name": "Detalle de la ruta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (CA-10)', () => pm.response.to.have.status(200));",
                  "const ruta = pm.response.json();",
                  "pm.test('recorrido [lng, lat] y marca de mía (CA-12)', () => {",
                  "  pm.expect(ruta.path.length).to.be.at.least(2);",
                  "  pm.expect(ruta.path[0][0]).to.be.closeTo(-127, 0.0001);",
                  "  pm.expect(ruta.isMine).to.eql(true);",
                  "  pm.expect(ruta.sourceActivityId).to.eql(pm.collectionVariables.get('publishActivityId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/routes/{{routeId}}"
          }
        },
        {
          "name": "Editar nombre y zona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (CA-22)', () => pm.response.to.have.status(200));",
                  "const ruta = pm.response.json();",
                  "pm.test('nombre nuevo, zona borrada y distancia sin cambios (RN-1)', () => {",
                  "  pm.expect(ruta.name).to.eql('Ruta de Postman editada');",
                  "  pm.expect(ruta.region).to.eql(null);",
                  "  pm.expect(ruta.distanceMeters).to.eql(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/routes/{{routeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ruta de Postman editada\",\n  \"region\": \"\",\n  \"distanceMeters\": 1\n}"
            }
          }
        },
        {
          "name": "Nombre de 41 caracteres (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 (CA-5)', () => pm.response.to.have.status(400));",
                  "pm.test('error junto al campo, en español', () => {",
                  "  pm.expect(pm.response.json().errors.name).to.include('El nombre debe tener como máximo 40 caracteres');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/routes/{{routeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\"\n}"
            }
          }
        },
        {
          "name": "Guardar en favoritas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 (CA-15)', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/routes/{{routeId}}/favorite"
          }
        },
        {
          "name": "Guardar otra vez (idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 sin duplicar (CA-16)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/routes/{{routeId}}/favorite"
          }
        },
        {
          "name": "Mis favoritas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (CA-18)', () => pm.response.to.have.status(200));",
                  "const favoritas = pm.response.json();",
                  "const id = pm.collectionVariables.get('routeId');",
                  "pm.test('la ruta está una sola vez y disponible', () => {",
                  "  const mias = favoritas.filter((f) => f.id === id);",
                  "  pm.expect(mias.length).to.eql(1);",
                  "  pm.expect(mias[0].available).to.eql(true);",
                  "  pm.expect(mias[0]).to.have.keys('id', 'name', 'type', 'distanceMeters', 'elevationGainMeters', 'available', 'savedAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/routes/favorites"
          }
        },
        {
          "name": "Archivar",
          "event": [
