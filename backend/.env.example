# Copia este archivo a `.env` y llena los valores. Nunca subas el `.env` al repositorio (constitución 3.6).

# PostgreSQL de Supabase: el pooler para la app y la conexión directa para las migraciones.
DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRE_IN=

# Opcionales: puerto del servidor (3000 por omisión) y origen permitido por CORS.
PORT=
CORS_ORIGIN=

# Cuenta de prueba de los casos manuales de la spec 005 (M9). Solo local.
MANUAL_TEST_EMAIL=
MANUAL_TEST_PASSWORD=

# Cuenta con 200 actividades de ejemplo (spec 014, T13: npm run seed:actividades). Solo local.
SEED_ACTIVIDADES_EMAIL=
SEED_ACTIVIDADES_PASSWORD=

# Bot de Telegram (spec 008). Crea uno de desarrollo y otro de producción con @BotFather.
# TELEGRAM_MODE: log (solo registra, no manda nada; por omisión fuera de producción),
# polling (getUpdates, para desarrollo con el bot real) o webhook (producción).
TELEGRAM_MODE=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secreto que Telegram manda en X-Telegram-Bot-Api-Secret-Token. Obligatorio con webhook.
TELEGRAM_WEBHOOK_SECRET=
